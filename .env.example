# Скопируйте этот файл в .env и заполните. Нужен хотя бы один канал доставки заявок.

PORT=3000
# Если сайт работает за nginx/прокси — 1 (для корректного IP в защите от спама)
TRUST_PROXY=0

# --- Telegram (рекомендуется: заявки мгновенно приходят в телефон) ---
# Создайте бота у @BotFather, добавьте его в нужный чат и узнайте chat_id (например, через @getmyid_bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail через SMTP (пример для Яндекс Почты: smtp.yandex.ru, 465, пароль приложения) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- CRM ---
# Битрикс24: входящий вебхук с правами «CRM», вида https://xxx.bitrix24.ru/rest/1/abcdef/
BITRIX24_WEBHOOK_URL=
# Любая другая CRM или интегратор (amoCRM через Albato / Make / ApiX-Drive и т.п.): заявка отправляется POST-запросом в JSON
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Админ-панель (/admin). Без пароля панель выключена ---
ADMIN_USER=admin
ADMIN_PASSWORD=

TIMEZONE=Asia/Yekaterinburg
